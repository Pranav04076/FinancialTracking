# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored; never commit it.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/FinanceTracker

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=3000

# Groq API key — get yours at https://console.groq.com/keys
GROQ_API_KEY=
